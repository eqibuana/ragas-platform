# Copy this to services/scenario-db-service/.env for local overrides (gitignored).
# docker-compose.yml also reads these directly from your shell / a .env file in this directory.

POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173

# AI Platform this service relays login to and calls during a RAGAS run.
# Defaults to the same URL services/ragas-service/ragas_evaluation.py uses.
AI_PLATFORM_URL=http://k8s-aiplatfo-frontend-1732695a13-fe3650871f8fb59b.elb.ap-southeast-3.amazonaws.com

# Judge LLM (Bedrock) + embeddings (SageMaker) for scoring runs — same values as
# services/ragas-service/.env. Copy them here rather than re-typing.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=ap-southeast-3
